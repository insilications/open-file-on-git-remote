{
  "name": "open-file-on-git-remote",
  "displayName": "open-file-on-git-remote",
  "description": "Simple command that allows you to open any file tracked in your repo",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "file",
    "open",
    "browser"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:open-file-on-git-remote.openRemoteFile"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "open-file-on-git-remote.openRemoteFile",
        "title": "Open File on Git Remote"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Open File on Git Remote",
      "properties": {
        "open-file-on-git-remote.customUrl": {
          "type": "string",
          "default": null,
          "description": "Custom URL to use for opening files on the remote repository. If not set, the extension will try to determine the remote URL from the git configuration."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "open-file-on-git-remote.openRemoteFile",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "open-file-on-git-remote.openRemoteFile",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wrhansen/open-file-on-git-remote.git"
  },
  "publisher": "WesleyHansen"
}
